{
  "$schema": "../../schemas/resizer-presets.schema.json",
  "version": 1,
  "presets": [
    {
      "id": "photo-240",
      "name": "Photo 240×240 px @200 DPI (about 3×3 cm)",
      "description": "Square photo, 20–50 KB JPEG. 240 px at 200 DPI = 3.048 cm.",
      "settings": { "width": 240, "height": 240, "unit": "px", "dpi": 200, "sizeMode": "exactPixels", "lockAspect": true,
                    "fit": "crop", "format": "jpeg", "sizeRange": { "min": 20, "max": 50, "unit": "KB" } }
    },
    {
      "id": "signature-140x60",
      "name": "Signature 140×60 px",
      "description": "Signature on white, 10–20 KB JPEG. Padding keeps the whole signature visible.",
      "settings": { "width": 140, "height": 60, "unit": "px", "dpi": 200, "sizeMode": "exactPixels", "lockAspect": true,
                    "fit": "pad", "padColor": "#FFFFFF", "format": "jpeg", "sizeRange": { "min": 10, "max": 20, "unit": "KB" },
                    "allowPadding": true }
    },
    {
      "id": "photo-3x3cm",
      "name": "Photo 3×3 cm @200 DPI (exact physical size)",
      "description": "Physical size first: 3 cm at 200 DPI rounds to 236 px (−0.028 mm).",
      "settings": { "width": 3, "height": 3, "unit": "cm", "dpi": 200, "sizeMode": "exactPhysical", "lockAspect": true,
                    "fit": "crop", "format": "jpeg", "sizeRange": { "min": 20, "max": 50, "unit": "KB" } }
    },
    {
      "id": "postcard-10x15",
      "name": "Print 10×15 cm @300 DPI",
      "description": "Photo print size, high-quality JPEG, no size limit.",
      "settings": { "width": 15, "height": 10, "unit": "cm", "dpi": 300, "sizeMode": "exactPhysical", "lockAspect": true,
                    "fit": "crop", "format": "jpeg", "quality": 95, "sizeRange": null }
    },
    {
      "id": "web-1920",
      "name": "Web 1920×1080 WEBP (under 500 KB)",
      "description": "Fits the whole image into 1920×1080 with padding.",
      "settings": { "width": 1920, "height": 1080, "unit": "px", "dpi": 72, "sizeMode": "exactPixels", "lockAspect": false,
                    "fit": "pad", "padColor": "#000000", "format": "webp", "sizeRange": { "max": 500, "unit": "KB" } }
    }
  ]
}
