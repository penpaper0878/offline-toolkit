# Local development settings for the backend. Copy to backend/.env.
# Every setting is read from an environment variable with the CLP_ prefix (app/core/config.py).

CLP_ENV=development

# SQLite needs nothing installed and is also the offline / desktop store:
CLP_DATABASE_URL=sqlite:///./civillabpro.db
# PostgreSQL (with PostGIS on servers):
# CLP_DATABASE_URL=postgresql+psycopg://civillabpro:password@127.0.0.1:5432/civillabpro

# Required in production (at least 32 random characters); development has a built-in default.
# CLP_JWT_SECRET=

# Serve the built web client from this process (single-process mode):
# CLP_STATIC_DIR=../frontend/dist
