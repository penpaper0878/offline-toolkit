# Copy to deploy/.env and fill in. Never commit the copy.

# Database password (any long random string).
POSTGRES_PASSWORD=

# Signs the access tokens: at least 32 random characters, for example from
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CLP_JWT_SECRET=

# After the first organisation is registered, set this to false so only administrators add users.
CLP_ALLOW_SELF_REGISTRATION=true

# Host port the application listens on.
CLP_PORT=8000
