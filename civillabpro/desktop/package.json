{
  "name": "civillabpro-desktop",
  "productName": "CivilLabPro OS",
  "version": "0.7.0",
  "description": "CivilLabPro OS desktop: the design platform on this computer, with its data in a local SQLite file.",
  "author": "CivilLabPro OS",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "test": "node --test test/launcher.test.js",
    "server": "python scripts/build_server.py",
    "pack": "electron-builder --dir",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "in.civillabpro.desktop",
    "productName": "CivilLabPro OS",
    "artifactName": "CivilLabPro-OS-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "main.js",
      "launcher.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "web"
      },
      {
        "from": "build/clp-server",
        "to": "server"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Science",
      "icon": "build-resources/icon.png",
      "synopsis": "Civil engineering design to Indian Standards",
      "executableName": "civillabpro",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build-resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  },
  "desktopName": "civillabpro.desktop"
}
